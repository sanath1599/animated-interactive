# Public URL of the site (used for OAuth callbacks and the same-origin/CSRF check)
APP_URL=https://app.antm.ai
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
DATA_DIR=/var/lib/demo-studio

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Private key PEM with newlines written as \n
GITHUB_APP_PRIVATE_KEY=

# docker (isolated, production) | local (dev only, NOT isolated) | mock (tests only)
RUNNER_MODE=docker
RUNNER_IMAGE=demo-studio-runner:latest
# session = reuse the server owner's Claude Code login (pre-production); api_key = ANTHROPIC_API_KEY
CLAUDE_AUTH_MODE=session
CLAUDE_CONFIG_DIR=
ANTHROPIC_API_KEY=

MAX_CONCURRENT_RUNS=2
MAX_RUNS_PER_USER_PER_DAY=10
RUN_TIMEOUT_MINUTES=60
RETENTION_DAYS=14
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=5
